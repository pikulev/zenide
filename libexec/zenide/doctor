#!/usr/bin/env bash
# Диагностика: текст, --json или интерактивный --ui (Textual).
# keys: / поиск · Ctrl-p только проблемы · Ctrl-r перепроверить · Ctrl-o открыть файл · q выход
set -uo pipefail

format=text
[ "$#" -le 1 ] || { printf 'zenide doctor: нужен один режим\n' >&2; exit 2; }
case "${1:-}" in
'') ;;
--json) format=json ;;
--ui) exec bash "$ZENIDE_LIBEXEC/ui/launch.sh" ;;
-h | --help)
    printf 'zenide doctor [--json | --ui]\nБез аргументов — текстовый отчёт; --ui требует опциональное окружение Textual.\n'
    exit 0 ;;
*) printf 'zenide doctor: неизвестный аргумент %s\n' "$1" >&2; exit 2 ;;
esac

# shellcheck source=libexec/zenide/lib/doctor-report.sh
. "$ZENIDE_LIBEXEC/lib/doctor-report.sh" "$format"
fail=0
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
have() { command -v "$1" >/dev/null 2>&1; }
report_begin

section slots 'слоты (profile/modules.conf)'
for role in editor git_tui files search; do
    case "$role" in
    editor) tool="$ZENIDE_EDITOR"; label=редактор ;;
    git_tui) tool="$ZENIDE_GIT_TUI"; label=git-TUI ;;
    files) tool="$ZENIDE_FILES"; label=файлы ;;
    search) tool="$ZENIDE_SEARCH"; label=замена ;;
    esac
    emit "slot.$role" info "$label" "$tool" \
        'Выбор из modules.conf и подключённого им modules.local. Изменение не перезапускает открытые инструменты.' \
        "$ZENIDE_PROFILE/modules.conf"
done
if [ -d "$ZENIDE_LIBEXEC/editor/$ZENIDE_EDITOR" ]; then
    emit editor.adapter ok 'Адаптер редактора' "editor/$ZENIDE_EDITOR найден"
else
    emit editor.adapter error 'Адаптер редактора' "Нет editor/$ZENIDE_EDITOR — open/ctx/reload/goto не работают" \
        'Выбери существующий адаптер в профиле.' "$ZENIDE_PROFILE/modules.conf"
fi

section required обязательное
# Проверяем именно окружение вызова, не приписываем ему PATH других пейнов.
required() {
    local id="$1" tool="$2" impact="$3"
    if have "$tool"; then
        emit "$id" ok "$tool" "Найден: $(command -v "$tool")"
    else
        emit "$id" error "$tool" "Не найден в PATH. $impact" \
            'Установи выбранный инструмент и проверь PATH окружения, из которого запущен doctor.' "$ZENIDE_PROFILE/modules.conf"
    fi
}
for tool in tmux git fzf; do required "required.$tool" "$tool" 'Без него ядро не работает.'; done
case "$ZENIDE_EDITOR" in helix) required required.editor hx 'Мост в редактор не работает.' ;; esac
required required.files "$ZENIDE_FILES" 'C-Space e/E не работают.'
required required.git_tui "$ZENIDE_GIT_TUI" 'C-Space g/G не работают.'
if have tmux; then
    v="$(tmux -V 2>/dev/null | sed 's/[^0-9.]//g')"
    maj="${v%%.*}"; min="${v#*.}"; min="${min%%.*}"
    if [[ "$maj" =~ ^[0-9]+$ && "$min" =~ ^[0-9]+$ ]] &&
        { [ "$maj" -gt 3 ] || { [ "$maj" -eq 3 ] && [ "$min" -ge 3 ]; }; }; then
        emit tmux.version ok 'Версия tmux' "$v (нужен ≥ 3.3: display-popup, allow-passthrough)"
    else
        emit tmux.version error 'Версия tmux' "Версия ${v:-не определена}; нужен ≥ 3.3" 'Обнови tmux для попапов и превью yazi.'
    fi
fi

section optional 'возможности среды'
optional() {
    local id="$1" tool="$2" impact="$3" hint="$4"
    if have "$tool"; then
        emit "$id" ok "$tool" "Найден: $(command -v "$tool"). $impact"
    else
        emit "$id" warn "$tool" "Не найден в PATH. Недоступно: $impact" "$hint"
    fi
}
optional optional.fd fd 'C-Space o — список файлов проекта' 'На macOS: brew install fd'
optional optional.rg rg 'подсветка превью в поиске' 'На macOS: brew install ripgrep'
optional optional.rga rga 'C-Space / — поиск по содержимому (live-grep)' 'На macOS: brew install ripgrep-all'
optional optional.delta delta 'подсветка diff и blame, C-Space D/B' 'На macOS: brew install git-delta'
optional optional.bat bat 'подсветка колонки кода в blame; сам попап работает' 'На macOS: brew install bat'
optional optional.search "$ZENIDE_SEARCH" 'C-Space R — замена по проекту' 'Установи выбранный search-инструмент или измени слот в modules.local.'
optional optional.zoxide zoxide 'прыжок Z в файловом менеджере' 'На macOS: brew install zoxide'

# mise нужен только тогда, когда он уже участвует в окружении.
mise_cfg="$CONFIG_DIR/mise"
if ! have mise; then
    if [ -L "$mise_cfg" ]; then
        section runtimes 'рантаймы (mise)'
        emit mise.binary warn mise 'Конфиг слинкован, но mise не найден — инструменты не установятся.' 'На macOS: brew install mise' "$mise_cfg/config.toml"
    fi
else
    section runtimes 'рантаймы (mise)'
    emit mise.binary ok mise "Найден: $(command -v mise)"
    shims="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims"
    case ":$PATH:" in
    *":$shims:"*) emit mise.shims ok 'Шимы mise' "$shims есть в PATH этого процесса" ;;
    *) emit mise.shims warn 'Шимы mise' "$shims отсутствует в PATH этого процесса" \
        'В попапах инструменты могут не найтись. Проверь подключение mise --shims после brew.sh.' "$ZENIDE_ROOT/shell/parts/mise.sh" ;;
    esac
    for tool in node pnpm; do
        want="$(mise which "$tool" 2>/dev/null)" || want=""
        got="$(command -v "$tool" 2>/dev/null)" || got=""
        [ -n "$want" ] && [ -n "$got" ] || continue
        case "$got" in
        *'/mise/'*) emit "mise.path.$tool" ok "$tool: источник" "$got (mise ожидает $want)" ;;
        *) emit "mise.path.$tool" warn "$tool: источник" "PATH: $got; mise: $want" \
            'Проверь порядок PATH: parts/mise.sh после brew.sh.' "$ZENIDE_ROOT/shell/parts/mise.sh" ;;
        esac
    done
    if miss="$(mise ls --missing 2>/dev/null)"; then
        if [ -n "$miss" ]; then
            emit mise.missing warn 'Установка инструментов mise' "$miss" 'В нужном каталоге: mise install && mise reshim' "$mise_cfg/config.toml"
        else
            emit mise.missing ok 'Установка инструментов mise' 'mise ls --missing не сообщил недостающих инструментов в текущем каталоге.'
        fi
    else
        emit mise.missing warn 'Установка инструментов mise' 'mise ls --missing завершился с ошибкой; состояние неизвестно.' 'Запусти mise ls --missing вручную и проверь сообщение об ошибке.' "$mise_cfg/config.toml"
    fi
fi

section contracts 'требования к соседям'
hx_cfg="$CONFIG_DIR/helix/config.toml"
if [ -r "$hx_cfg" ]; then
    if grep -qE '^[[:space:]]*focus-lost[[:space:]]*=[[:space:]]*true([[:space:]]|#|$)' "$hx_cfg"; then
        emit helix.autosave ok 'Helix: focus-lost' 'Найдена строка focus-lost = true. Это проверка текста, не состояния работающего Helix.' \
            'Строка должна относиться к [editor.auto-save].' "$hx_cfg"
    else
        emit helix.autosave error 'Helix: focus-lost' 'Не найдена строка focus-lost = true. Без автосохранения reload-all может потерять несохранённые правки.' \
            "Сверь [editor.auto-save] с $ZENIDE_ROOT/ide/helix/CONTRACT.toml; альтернативную запись TOML проверь вручную." "$hx_cfg"
    fi
else
    emit helix.autosave warn 'Helix: focus-lost' "Не найден $hx_cfg — состояние неизвестно." \
        "Проверь auto-save.focus-lost по $ZENIDE_ROOT/ide/helix/CONTRACT.toml." "$hx_cfg"
fi
yz_cfg="$CONFIG_DIR/yazi/yazi.toml"
if [ -r "$yz_cfg" ]; then
    if grep -q 'zenide open' "$yz_cfg"; then
        emit yazi.opener ok 'Yazi: открытие файлов' 'В конфиге найден вызов zenide open; работающий процесс отдельно не проверялся.' '' "$yz_cfg"
    else
        emit yazi.opener warn 'Yazi: открытие файлов' 'В конфиге нет вызова zenide open — Enter может не отдавать файл в hx.' \
            "Сверь с $ZENIDE_ROOT/ide/yazi/CONTRACT.toml." "$yz_cfg"
    fi
fi

section shadow 'затенение'
if [ -e "$HOME/.tmux.conf" ]; then
    emit shadow.tmux warn 'Конфиг tmux' '~/.tmux.conf имеет приоритет при старте tmux; подключение zenide нужно проверить.' \
        "Проверь source-file $CONFIG_DIR/tmux/tmux.conf в этом файле. Уже запущенный сервер не проверялся." "$HOME/.tmux.conf"
else
    emit shadow.tmux ok 'Конфиг tmux' '~/.tmux.conf отсутствует — этот путь не затеняет XDG-конфиг.'
fi
if [ -e "$HOME/.gitconfig" ]; then
    emit shadow.git warn 'Глобальный конфиг Git' '~/.gitconfig читается после XDG-конфига и может переопределять его значения.' \
        'Проверь нужные значения: git config --global --list --show-origin. Наличие файла само по себе не означает поломку.' "$HOME/.gitconfig"
else
    emit shadow.git ok 'Глобальный конфиг Git' '~/.gitconfig отсутствует — переопределений из него нет.'
fi

section installation установка
if [ -x "$CONFIG_DIR/zenide/bin/zenide" ]; then
    emit install.core ok 'Ядро' "$CONFIG_DIR/zenide/bin/zenide доступен"
else
    emit install.core error 'Ядро' "Нет рабочего ядра $CONFIG_DIR/zenide" 'Из клона: ./install.sh — посмотреть план, ./install.sh --apply — установить.'
fi
if [ -r "$CONFIG_DIR/tmux/tmux.conf" ]; then
    emit install.tmux ok 'Конфиг tmux' "$CONFIG_DIR/tmux/tmux.conf доступен" '' "$CONFIG_DIR/tmux/tmux.conf"
else
    emit install.tmux error 'Конфиг tmux' "Нет $CONFIG_DIR/tmux/tmux.conf" 'Из клона: ./install.sh — посмотреть план, ./install.sh --apply — установить.'
fi
anchor="$CONFIG_DIR/zenide-profile"
if [ -L "$anchor" ] && [ -d "$anchor" ]; then
    emit profile.anchor ok 'Якорь профиля' "$anchor → $(readlink "$anchor")"
elif [ -d "$anchor" ]; then
    emit profile.anchor ok 'Якорь профиля' "$anchor — внешний каталог"
else
    emit profile.anchor error 'Якорь профиля' "$anchor отсутствует или ссылка не работает" 'Из клона: ./install.sh — посмотреть план восстановления.'
fi
emit profile.active info 'Активный профиль' "$ZENIDE_PROFILE" 'Приоритет: ZENIDE_PROFILE → якорь zenide-profile → профиль клона.' "$ZENIDE_PROFILE/modules.conf"
core_ver="$(cat "$ZENIDE_ROOT/VERSION" 2>/dev/null)"
prof_ver="$(cat "$ZENIDE_PROFILE/.zenide-version" 2>/dev/null)"
if [ -z "$prof_ver" ]; then
    emit profile.version warn 'Версия профиля' "Отметки нет; версия ядра $core_ver" 'Сверь схему профиля с CHANGELOG перед обновлением отметки.' "$ZENIDE_PROFILE/.zenide-version"
elif [ "$prof_ver" != "$core_ver" ]; then
    emit profile.version warn 'Версия профиля' "Профиль $prof_ver, ядро $core_ver" 'Сверь CHANGELOG и затем обнови .zenide-version.' "$ZENIDE_PROFILE/.zenide-version"
else
    emit profile.version ok 'Версия профиля' "Профиль и ядро: $core_ver"
fi
if have zenide; then
    emit install.path ok 'zenide на PATH' "$(command -v zenide)"
else
    emit install.path warn 'zenide на PATH' 'Команда не найдена.' "Зови $CONFIG_DIR/zenide/bin/zenide или добавь ~/.local/bin в PATH."
fi

section ownership 'что сейчас чьё'
MANIFEST="${XDG_STATE_HOME:-$HOME/.local/state}/zenide/manifest"
layers_file="$ZENIDE_ROOT/ide/LAYERS"
if [ -r "$layers_file" ]; then
    while IFS='|' read -r tool layer contract impact; do
        tool="$(printf '%s' "$tool" | tr -d '[:space:]')"
        layer="$(printf '%s' "$layer" | tr -d '[:space:]')"
        contract="$(printf '%s' "$contract" | tr -d '[:space:]')"
        case "$tool" in '' | '#'*) continue ;; esac
        dst="$CONFIG_DIR/$tool"
        [ "$tool" != prettier ] || dst="$HOME/.prettierrc"
        if [ -L "$dst" ]; then
            case "$(readlink "$dst")" in
            "$ZENIDE_ROOT"/*) owner='zenide (симлинк на клон)' ;;
            *) owner="чужой симлинк → $(readlink "$dst")" ;;
            esac
        elif [ -e "$dst" ]; then
            if [ -r "$MANIFEST" ] && grep -qF "$(printf '\t%s\t' "$dst")" "$MANIFEST"; then
                owner='zenide (копия по манифесту; содержимое не сверялось)'
            else
                owner='твой — zenide его не трогает'
            fi
        else
            owner=нет
        fi
        file=""
        [ -z "$contract" ] || file="$ZENIDE_ROOT/ide/$tool/$contract"
        emit "ownership.$tool" info "$tool · $layer" "$dst: $owner" "Без конфига zenide: $impact" "$file"
    done < "$layers_file"
else
    emit ownership.layers warn 'Слои' "Нет $layers_file — принадлежность неизвестна."
fi
baks="$(find "$CONFIG_DIR" "$HOME" -maxdepth 1 -name '*.backup.*' 2>/dev/null)"
[ -z "$baks" ] || emit install.backups info 'Найденные бэкапы' "$baks" 'Откат install.sh --uninstall использует только записи своего манифеста.' "$MANIFEST"
if [ -r "$MANIFEST" ]; then
    emit install.manifest info 'Манифест установки' "$MANIFEST" 'Журнал операций установщика; просмотр не меняет установку.' "$MANIFEST"
else
    emit install.manifest info 'Манифест установки' 'Манифеста нет — автоматический откат установки недоступен.'
fi

section modules модули
for d in "$ZENIDE_ROOT"/modules/*/; do
    [ -d "$d" ] || continue
    m="${d%/}"; m="${m##*/}"
    desc="$(sed -n '2s/^#[[:space:]]*//p' "$d/init.sh" 2>/dev/null)"
    case " $ZENIDE_MODULES " in *" $m "*) state='включён в профиле' ;; *) state='выключен в профиле' ;; esac
    emit "module.$m" info "$m" "$state. $desc" \
        'Состояние хуков работающего tmux не проверяется. Удаление из списка не снимает ранее установленные хуки.' "$d/README.md"
done
seen_modules=' '
for m in $ZENIDE_MODULES; do
    case "$seen_modules" in *" $m "*) continue ;; esac
    seen_modules="$seen_modules$m "
    if [ ! -x "$ZENIDE_ROOT/modules/$m/init.sh" ]; then
        emit "module.$m.init" warn "$m" 'Нет исполняемого init.sh — модуль не загрузится.' 'Проверь имя модуля в modules.local.' "$ZENIDE_PROFILE/modules.conf"
        continue
    fi
    chk="$ZENIDE_ROOT/modules/$m/check.sh"
    [ -x "$chk" ] || continue
    if out="$("$chk" 2>&1)"; then state=ok; else state=warn; fi
    emit "module.$m.check" "$state" "$m: check.sh" "$out" 'Это результат проверки модуля; системные разрешения могут требовать ручной проверки.' "$ZENIDE_ROOT/modules/$m/README.md"
done

report_end
exit "$fail"
