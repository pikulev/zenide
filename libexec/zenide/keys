#!/usr/bin/env bash
# C-Space ? : шпаргалка по ВСЕМУ сетапу в попапе, с фаззи-фильтром.
#
# Своих данных не хранит — собирает из живого tmux и из скриптов рядом, поэтому
# рассинхрон с реальными биндами невозможен по конструкции:
#   · твои бинды — `tmux list-keys -N`, заметка в формате "группа: описание".
#     Группа должна быть в ORDER ниже; ORDER же задаёт порядок секций и служит
#     признаком «это мой бинд, а не дефолт tmux». Добавил бинд с
#     -N "поиск: …" — строка сама появилась в секции «поиск», скрипт не трогаем.
#   · клавиши ВНУТРИ попапов/TUI — строка `legend='…'` (blame) или `# keys: …`
#     (остальные) в подкомандах libexec, в твоих скриптах из profile/ и в
#     tmux.conf. Для подкоманды метка выводится из list-keys: ищем, какая
#     prefix-клавиша зовёт `zenide <имя>`.
#   · дефолты tmux — остальные заметки list-keys -N, отдельной секцией снизу.
#
# Личный скрипт со строкой `# keys:` в profile/ попадает сюда САМ — это и есть
# точка расширения: ядро для своего бинда править не нужно.
#
# Кириллических двойников в списке нет и это правильно: list-keys без -N
# заметки не печатает → двойники их не наследуют и справку не раздувают вдвое.
# Про них — строка в хедере fzf.
set -eu

# Запасные значения на случай прямого запуска мимо диспетчера: обычно всё
# три приезжают из `bin/zenide` (он и резолвит профиль — см. ступени там).
: "${ZENIDE_LIBEXEC:=$(cd "$(dirname "$0")" && pwd)}"
: "${ZENIDE_ROOT:=$(cd "$ZENIDE_LIBEXEC/../.." && pwd)}"
: "${ZENIDE_PROFILE:=$ZENIDE_ROOT/profile}"
# откуда грепаются строки `# keys:` — сам конфиг tmux, а не его место установки
CFG="$ZENIDE_ROOT/ide/tmux"
# порядок секций «моих» клавиш (он же — список признаваемых групп)
ORDER='проекты окна панели файлы git поиск copy-mode прочее справка'

dim=$'\033[38;5;242m'
bold=$'\033[1;97m'
rst=$'\033[0m'

# ── 1. мои бинды + дефолты tmux, из заметок ────────────
# -P '' убирает "C-Space " из каждой строки → первый токен = клавиша.
# copy-mode-vi: у дефолтов этой таблицы заметок нет вовсе, так что сюда попадут
# только мои v/y с -N.
notes="$(
    {
        tmux list-keys -N -P '' -T prefix
        tmux list-keys -N -P '' -T copy-mode-vi
    } 2>/dev/null | sed 's/^[[:space:]]*//'
)"

# want=mine — мои бинды, секциями в порядке ORDER; want=def — всё остальное,
# т.е. дефолты tmux. Два прохода, а не один: между ними вклинивается секция
# «внутри попапов» (п.2), а дефолты должны остаться в самом низу.
group() {
    printf '%s\n' "$notes" | awk -v order="$ORDER" -v want="$1" -v b="$bold" -v d="$dim" -v r="$rst" '
    BEGIN { n = split(order, O, " "); for (i = 1; i <= n; i++) idx[O[i]] = i }
    {
        key = $1; $1 = ""; sub(/^ /, ""); note = $0
        p = index(note, ": ")
        g = (p ? substr(note, 1, p - 1) : "")
        mine = (g in idx)
        line = sprintf("  %s%-8s%s %s", b, key, r, (mine ? substr(note, p + 2) : note))
        if (mine) MY[g] = MY[g] line "\n"
        else DEF = DEF line "\n"
    }
    END {
        # скобки обязательны: без них else прилипает к внутреннему if внутри for
        # (dangling else) и ветка дефолтов не печатается вообще
        if (want == "mine") {
            for (i = 1; i <= n; i++)
                if (O[i] in MY) printf "%s── %s ──%s\n%s\n", d, O[i], r, MY[O[i]]
        } else if (DEF != "") {
            printf "%s── дефолты tmux ──%s\n%s", d, r, DEF
        }
    }'
}

# ── 2. клавиши внутри попапов и TUI-окон ───────────────
# Метка для подкоманды = prefix-клавиша, которая её зовёт. Ищем в list-keys
# подстроку «zenide <имя>» (а не имя файла, как было до диспетчера). Фильтр
# $4 ~ /^[ -~]+$/ берёт ЛАТИНСКИЙ бинд: кириллический двойник в UTF-8
# многобайтный и под ASCII-диапазон не попадает.
keymap="$(tmux list-keys -T prefix 2>/dev/null || true)"

# `case` внутри $( ) ломает разбор — поэтому фильтр отдельной функцией.
# Данные (конфиги, примеры, доки) не сканируем: `# keys:` бывает только в коде.
is_code() {
    case "${1##*/}" in
    *.md | *.conf | *.example | *.local | *.txt) return 1 ;;
    esac
    return 0
}

popup_keys="$(
    for f in "$ZENIDE_LIBEXEC"/* "$ZENIDE_PROFILE"/*; do
        [ -f "$f" ] || continue
        is_code "$f" || continue
        leg="$(sed -n -e "s/^legend='\(.*\)'[[:space:]]*$/\1/p" -e 's/^# keys:[[:space:]]*//p' "$f" | head -1)"
        [ -n "$leg" ] || continue
        key="$(printf '%s\n' "$keymap" | awk -v s="zenide ${f##*/}" '
            index($0, s) && $4 ~ /^[ -~]+$/ { print $4; exit }')"
        [ -n "$key" ] || continue
        printf '  %s%-8s%s %s\n' "$bold" "$key" "$rst" "$leg"
    done
    # tmux.conf: инструменты без своего скрипта (yazi, scooter) — метка в самой
    # строке: `# keys: <метка> · <клавиши…>`
    sed -n 's/^# keys:[[:space:]]*//p' "$CFG/tmux.conf" 2>/dev/null | while IFS= read -r l; do
        lbl="${l%% · *}"
        printf '  %s%-8s%s %s\n' "$bold" "$lbl" "$rst" "${l#* · }"
    done
)"

# ── 3. рендер: мои бинды → внутри попапов → дефолты tmux ──
render() {
    group mine
    # if, а не `[ … ] && printf`: при пустом popup_keys такой && вернул бы 1 и
    # set -e убил бы скрипт на полуслове
    if [ -n "$popup_keys" ]; then
        printf '%s── внутри попапов и окон ──%s\n%s\n\n' "$dim" "$rst" "$popup_keys"
    fi
    group def
}

# --print: отдать тот же текст в stdout, без fzf. Нужно тестам (интерактивный
# fzf из-под неинтерактивного процесса не прогнать — он лезет в /dev/tty) и
# удобно для отладки: видно, что именно попадёт в попап.
if [ "${1:-}" = --print ]; then
    render
    exit 0
fi

render | fzf --ansi --layout reverse --prompt 'keys ❯ ' --header-first \
        --header 'набери для фильтра · Esc закрыть · буквы работают и в русской раскладке (двойники)' \
        >/dev/null || true
