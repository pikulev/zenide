# Минимум, который нужен, чтобы tig отдавал строки в работающий hx.
# Врежь в свой ~/.tigrc или ~/.config/tig/config.
#
# Это слой `slot`: без него tig работает сам по себе, просто прыжок на строку
# поднимет отдельный редактор мимо шины zenide.

# Передавать редактору номер выбранной строки (как +<line>).
set editor-line-number = yes

# Вторая половина контракта живёт НЕ в конфиге, а в окружении: tig зовёт
# $TIG_EDITOR, и он должен указывать на обёртку hx-goto.sh — она переводит
# vi-шный «+<line> <file>» в ожидаемый helix «file:line» и уводит это в
# работающий hx. В zenide переменную выставляет shell/parts/tig.sh:
#
#   export TIG_EDITOR="${ZENIDE_ROOT:-$HOME/.config/zenide}/ide/tig/hx-goto.sh"
#
# Без TIG_EDITOR строка выше ничего не даёт: tig просто откроет $EDITOR.
