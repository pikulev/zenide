.DS_Store

# Личный слой: в публичную историю не попадает.
# profile/*.local — identity, рабочие корни проектов, прочее личное.
# shell/parts/private/ — личные фрагменты шелла (сорсятся zshrc.sh, если есть).
profile/*.local
shell/parts/private/

# Отметка версии ядра, под которую собран профиль (её пишет install.sh).
# Состояние ЭТОЙ машины, а не репозитория: когда профиль лежит внутри клона,
# закоммиченная отметка всегда равна VERSION из того же клона — и проверка
# дрейфа в doctor становится пустой.
profile/.zenide-version

# Песочница ./try — одноразовая, в историю не попадает.
.sandbox/
